# 環境ごとの値・秘密情報のひな型（実体は .env に置き、git にコミットしない）。
# 使い方: このファイルを .env にコピーし、環境に合わせて値を設定する。

# ここにプロジェクト固有の設定値を記述する（例）。
# API_KEY=
# SERVICE_ENDPOINT=

# 認証にサブスクリプション（Claude Max）を使う場合、ANTHROPIC_API_KEY は
# 設定しない（設定すると従量課金扱いになる）。
# ANTHROPIC_API_KEY=

# MAX_PER_SITE=

# QIITA_TOKEN=
# HATENA_MIN_USERS=
# MAX_PER_SITE=

# X_ENABLED=
# X_BEARER_TOKEN=
# X_MAX_POSTS=
# X_REQUIRE_LINK=
